{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci",
    "watchPatterns": [
      "/src/**",
      "/bin/**",
      "/scripts/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node bin/crosstalk.js serve --host 0.0.0.0 --trust-proxy --allow-origin https://cross-talk-sandy.vercel.app",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
