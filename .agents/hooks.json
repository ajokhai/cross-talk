{
  "crosstalk-hooks": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-tool.js",
            "timeout": 2
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/pre-invocation.js",
        "timeout": 2
      }
    ]
  }
}
